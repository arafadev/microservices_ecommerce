# Copy this file to .env (same folder) and change the values.
# docker compose reads .env automatically. Never commit the real .env.

# PostgreSQL (product-service, order-service)
DB_USER=postgres
DB_PASSWORD=change-me

# MongoDB (user-service)
MONGO_URI=mongodb://mongo:27017/ecom_user

# RabbitMQ (Spring Cloud Bus + config refresh)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# Zipkin (distributed tracing)
ZIPKIN_URL=http://zipkin:9411/api/v2/spans
